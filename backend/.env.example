# SQLite is used by default. Override with any SQLAlchemy SQLite URL if needed.
ASAIP_DATABASE_URL=sqlite:///./asaip.db
# Optional: without this key ASAIP uses its deterministic, clearly labelled demo engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_MAX_TOKENS=12000
# Comma-separated origins; localhost:5173 is always supported by default.
ASAIP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
