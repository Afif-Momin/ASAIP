# SQLite is used by default. Override with any SQLAlchemy SQLite URL if needed.
ASAIP_DATABASE_URL=sqlite:///./asaip.db

# Which analyzer to use: auto | demo | openrouter | anthropic
# auto  -> OpenRouter if its key exists, then Anthropic, then the labelled demo engine
# demo  -> always the deterministic, clearly labelled demo engine (no key needed)
AI_PROVIDER=auto

# Recommended for this PoC: one OpenRouter key gives access to GPT-4o-mini, Claude, Gemini, Llama, and DeepSeek.
# Keep this key in the backend environment only. Never place it in frontend code, VITE_ variables, or screenshots.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional overrides
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=ASAIP
OPENROUTER_APP_URL=

# Optional alternative provider, used when AI_PROVIDER=anthropic or when no OpenRouter key is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Shared JSON output ceiling for either live provider.
AI_MAX_TOKENS=12000

# Comma-separated origins; localhost:5173 is always supported by default.
ASAIP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
